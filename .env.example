# M365Portal example settings, for Docker Compose and for `docker run --env-file`.
# Copy this file to `.env` (which git ignores; never commit it) and change only what you need.
# Every active value below is the application default, and none of them is a secret. A variable
# that holds a secret (APP_KEY, SETUP_TOKEN, ...) is left unset and shown commented out, for you to
# fill in. HOST_PORT is the one variable that belongs to Compose only: the application never reads
# it. Every other variable is read by the application itself, and docker-compose.yml passes it on.

# Compose only. The port published on the Docker host: the port the browser connects to.
# HOST_PORT is not read by the application, so it has no effect with `docker run`; there you
# publish with `-p <host port>:<PORT>`. Reach a low host port (80, 443) with HOST_PORT, never with a
# low PORT. When you change it, PUBLIC_BASE_URL follows as long as it stays unset (see below).
HOST_PORT=9300

# The port the process listens on inside the container: an integer from 1024 to 65535 (the
# container runs unprivileged with all capabilities dropped). Anything else stops the start.
PORT=9300

# The address the process binds to inside the container. The image needs 0.0.0.0 for a published
# port to reach it. docker-compose.yml does not pass this variable on.
HOST=0.0.0.0

# Where the application keeps its database and files. It must match the volume mount of the
# container. docker-compose.yml does not pass this variable on.
DATA_DIR=/data

# The origin the browser uses to reach the panel, with the HOST_PORT in it. Every write is
# compared with it, so a wrong value shows up as 403 origin_not_allowed. It is left unset on
# purpose: Compose then uses http://localhost:<HOST_PORT>, so changing HOST_PORT alone is enough.
# Remove the hash and set it when the panel is reached under another name, for example behind a
# reverse proxy with HTTPS: https://panel.example.com
#PUBLIC_BASE_URL=http://localhost:9300

# none, a number of proxies in front (1 to 8), or a comma-separated list of at most 32 IP addresses
# or CIDR ranges that you trust. Keep none unless a reverse proxy sits in front: a wrong value
# lets a client forge its address and slip past the rate limit.
TRUST_PROXY=none

# true or false. Serves the /design component showcase, for development and demonstrations.
SHOWCASE=false

# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info

# Strict-Transport-Security, sent only over https. The max-age is in seconds, 0 to 63072000 (the
# default is one year).
HSTS_MAX_AGE=31536000

# true or false. Adds includeSubDomains, only on the host of PUBLIC_BASE_URL.
HSTS_INCLUDE_SUBDOMAINS=false

# true or false. Adds preload, which browsers cannot easily undo. It requires includeSubDomains
# (the setting above, true) and a max-age of at least 31536000.
HSTS_PRELOAD=false

# Sealing key and setup (Phase B). The variables below are left unset on purpose: uncomment a line
# and fill it in only when you need it. Never commit a real value, and never put one in this file.

# The key that seals the secrets in the database (the private key of the application certificate).
# 32 bytes as base64, base64url or 64 hexadecimal characters, from `node dist/cli.js
# generate-app-key`. Set exactly one of APP_KEY and APP_KEY_FILE (a file, for example a Docker
# secret, keeps the key out of the process list); neither is allowed until the setup wizard runs.
# docker-compose.yml does not pass this variable on: it mounts the key as the Docker secret app_key
# and sets APP_KEY_FILE. APP_KEY is for `docker run --env-file`.
#APP_KEY=

# The absolute path of a file that holds the key (at most 1,024 bytes, one trailing newline is
# ignored). Exclusive with APP_KEY. docker-compose.yml sets it to /run/secrets/app_key itself, so
# leave it unset in .env.
#APP_KEY_FILE=

# The previous key, set only while the key is rotated (rotate-app-key). Exclusive with
# APP_KEY_PREVIOUS_FILE.
#APP_KEY_PREVIOUS=

# The absolute path of a file that holds the previous key. Exclusive with APP_KEY_PREVIOUS.
#APP_KEY_PREVIOUS_FILE=

# The setup token for the first installation, 24 to 128 characters from A-Z a-z 0-9 - _ . ~ with at
# least 12 distinct characters. Unset: the application writes a token file in the data directory.
#SETUP_TOKEN=

# The public client of Microsoft that signs the administrator in during setup (a GUID).
BOOTSTRAP_CLIENT_ID=14d82eec-204b-4c2f-b7e8-296a70dab67e

# Seconds the wizard waits for Microsoft to propagate a role: 60 to 3600.
SETUP_PROPAGATION_TIMEOUT_SECONDS=900

# Minutes without activity before a session ends: 5 to 480.
SESSION_IDLE_TIMEOUT_MINUTES=30

# Hours a session lasts at most: 1 to 24, and hours x 60 must be greater than the idle minutes.
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# Seconds a group membership is cached before Microsoft is asked again: 30 to 3600.
GROUP_CACHE_TTL_SECONDS=300

# true or false. Requires a multi-factor sign-in from Microsoft Entra.
AUTH_REQUIRE_MFA=true

# Comma-separated values of the amr claim that count as multi-factor: 1 to 8 distinct values of 2 to
# 32 characters from a-z 0-9. pwd, wia and x509 are single-factor methods and are refused.
AUTH_MFA_AMR_VALUES=mfa,multipleauthn

# The break-glass account, a local sign-in for when Microsoft is unreachable: both variables, or
# neither. The username is 3 to 64 characters from A-Z a-z 0-9 . _ -
#BREAK_GLASS_USERNAME=

# The password hash from `node dist/cli.js hash-password`, which writes a line that starts with
# the word scrypt followed by colons. It has no dollar sign, so Compose does not interpolate it.
#BREAK_GLASS_PASSWORD_HASH=

# How the Exchange certificate reaches the PowerShell worker: memory or tmpfs. memory (the default)
# sends it over the pipe to the worker and writes nothing; tmpfs is the fallback that puts a file
# with mode 0600 in a private directory on a tmpfs (/dev/shm) for the time of the connection, for a PowerShell that cannot
# take the certificate from memory. Change it only on advice of docs/operations.md.
EXCHANGE_KEY_HANDOVER=memory

# Troubleshooting only, and temporary. Set it to 1 to put a masked, truncated Exchange error text
# (e-mail addresses, GUIDs and long tokens replaced by X, at most 300 characters) in the server log
# when an Exchange call fails; the worker otherwise never sends free text. A display name or a tenant
# name in the message is NOT masked: read the log before you share it. Remove this line again when you
# are done (an empty value stops the start). See docs/operations.md.
#EXCHANGE_DEBUG_ERRORTEXT=
