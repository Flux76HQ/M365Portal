{
  "name": "m365portal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @m365portal/server --filter @m365portal/web dev",
    "routes:generate": "pnpm --filter @m365portal/web generate",
    "routes:check": "pnpm routes:generate && git ls-files --error-unmatch apps/web/src/routeTree.gen.ts && git diff --exit-code -- apps/web/src/routeTree.gen.ts",
    "schema:snapshot": "pnpm --filter @m365portal/server schema:snapshot",
    "schema:check": "pnpm --filter @m365portal/server schema:check",
    "i18n:merge": "pnpm --filter @m365portal/shared i18n:merge",
    "i18n:check": "pnpm --filter @m365portal/shared i18n:check",
    "tokens:generate": "pnpm --filter @m365portal/shared tokens:generate",
    "tokens:check": "pnpm --filter @m365portal/shared tokens:check",
    "glyphs:generate": "pnpm --filter @m365portal/shared glyphs:generate",
    "lint": "pnpm routes:generate && eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "pnpm test:packages && pnpm test:tools && pnpm --filter @m365portal/e2e test:unit",
    "test:packages": "pnpm -r --filter \"!@m365portal/e2e\" test",
    "test:tools": "vitest run --config vitest.config.ts",
    "docs:check": "pnpm --filter @m365portal/server exec vitest run test/docs-contract.test.ts test/limits-doc.test.ts",
    "bundle:check": "tsx scripts/bundle-budget.ts",
    "build": "pnpm -r build",
    "image:smoke": "tsx scripts/image-smoke.ts",
    "e2e": "pnpm --filter @m365portal/e2e test",
    "lighthouse": "node e2e/lighthouse/run.mjs",
    "media": "tsx e2e/media/make-readme-media.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:prod": "pnpm audit --prod"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
